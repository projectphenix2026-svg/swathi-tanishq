// Cloudflare deploys only the web app (web/). The API (server/) is hosted separately.
// Set VITE_API_URL in the Cloudflare build settings once the API has a public address.
{
  "name": "swathi-tanishq",
  "compatibility_date": "2025-09-01",
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./web/dist",
    "not_found_handling": "single-page-application"
  }
}
