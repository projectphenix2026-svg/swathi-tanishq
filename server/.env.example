# Copy to server/.env and fill in. Never commit server/.env.

# --- App ---
PORT=4000
NODE_ENV=development
BUSINESS_NAME=Swathi Tanishq
# Front-end address allowed to call the API (comma-separate several).
WEB_ORIGIN=http://localhost:5173
# Long random string, e.g. from: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# First staff login, created on first start if no logins exist yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# --- Database ---
# Locally a SQLite file (Node's built-in SQLite). On Cloudflare the D1 database is used instead.
SQLITE_FILE=./.data/swathi.db

# --- Sending queue (the messages table) ---
# Messages sent per run, seconds between runs (Node only; Cloudflare runs every minute), tries per message.
SEND_BATCH_SIZE=20
DISPATCH_SECONDS=5
SEND_MAX_ATTEMPTS=4

# --- Sending ---
# mock = test mode, nothing is sent | twilio = Twilio WhatsApp (sandbox works) | meta = Meta WhatsApp Cloud API
MESSAGING_PROVIDER=mock
# Meta marketing rate for India, per message, before GST.
COST_PER_MESSAGE_INR=0.8631

# Public https URL of this API so providers can send delivery updates and replies
# (locally: a tunnel such as `npx cloudflared tunnel --url http://localhost:4000`). Empty = no webhooks.
PUBLIC_BASE_URL=
VALIDATE_WEBHOOK_SIGNATURES=true
# When webhooks cannot reach the API, ask the provider for statuses every N seconds (0 = off).
STATUS_POLL_SECONDS=20

# Twilio (console.twilio.com > Account info)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox: Messaging > Try it out > Send a WhatsApp message
TWILIO_WHATSAPP_FROM=+17372508034
TWILIO_SANDBOX_JOIN_CODE=join twilio-trial
TWILIO_SANDBOX_DISPLAY_NUMBER=+1 737 250 8034

# Meta WhatsApp Cloud API (developers.facebook.com > your app > WhatsApp > API setup)
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v25.0

# --- Phases 2-5 ---
# WhatsApp Business account ID (Meta > WhatsApp > API setup): needed to submit templates for approval.
META_WABA_ID=
# SMS backup: preview (records the SMS, sends nothing) until DLT registration is approved, then msg91.
SMS_MODE=preview
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
SMS_COST_INR=0.25
# How often birthday/anniversary/festival greetings are checked (minutes, 0 = off).
OCCASION_CHECK_MINUTES=15
